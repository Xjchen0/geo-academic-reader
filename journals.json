{
  "version": 2,
  "description": "Journal watch list copied from the user's own workflow (gongzhonghao2/fetch_journals_*.js). The scan opens these publisher pages in Chrome and lists what the page shows. Copy this file to .geo-reader/journals.json to customise it without touching the shipped defaults. It never searches by topic or infers papers from notes.",
  "defaults": {
    "days": 0,
    "limit": 0,
    "sort": "journal"
  },
  "journals": [
    {
      "key": "nature",
      "name": "Nature",
      "parser": "nature",
      "url": "https://www.nature.com/nature/research-articles",
      "wait": 5,
      "scroll": false,
      "enabled": true
    },
    {
      "key": "ngeo",
      "name": "Nature Geoscience",
      "parser": "nature",
      "url": "https://www.nature.com/ngeo/research-articles",
      "wait": 5,
      "scroll": false,
      "enabled": true
    },
    {
      "key": "ncomms",
      "name": "Nature Communications",
      "parser": "nature",
      "url": "https://www.nature.com/ncomms/research-articles",
      "wait": 5,
      "scroll": false,
      "enabled": true
    },
    {
      "key": "ncomms_web",
      "name": "Nature Communications (Web)",
      "parser": "nature",
      "url": "https://www.nature.com/ncomms/research-articles?searchType=journalSearch&sort=PubDate&page=130",
      "wait": 5,
      "scroll": false,
      "enabled": true
    },
    {
      "key": "science_first",
      "name": "Science",
      "parser": "science_first",
      "url": "https://www.science.org/toc/science/0/0",
      "wait": 6,
      "scroll": true,
      "ready": "h3[class*=\"article-title\"]",
      "enabled": true
    },
    {
      "key": "sciadv",
      "name": "Science Advances",
      "parser": "science_advances",
      "url": "https://www.science.org/toc/sciadv/current",
      "wait": 6,
      "scroll": true,
      "ready": "h3[class*=\"article-title\"]",
      "enabled": true
    },
    {
      "key": "epsl",
      "name": "EPSL",
      "parser": "epsl",
      "url_template": "https://www.sciencedirect.com/journal/earth-and-planetary-science-letters/vol/{volume}/suppl/C",
      "volumes": [699, 698, 697, 696],
      "wait": 6,
      "scroll": true,
      "ready": "a.article-content-title",
      "enabled": true
    },
    {
      "key": "grl",
      "name": "GRL",
      "parser": "agu",
      "url": "https://agupubs.onlinelibrary.wiley.com/journal/19448007",
      "wait": 5,
      "scroll": true,
      "ready": "div.issue-item",
      "enabled": true
    },
    {
      "key": "jgrse",
      "name": "JGR-Solid Earth",
      "parser": "agu",
      "url": "https://agupubs.onlinelibrary.wiley.com/journal/21699356",
      "wait": 5,
      "scroll": true,
      "ready": "div.issue-item",
      "enabled": true
    },
    {
      "key": "jgrp",
      "name": "JGR-Planets",
      "parser": "agu",
      "url": "https://agupubs.onlinelibrary.wiley.com/journal/21699100",
      "wait": 5,
      "scroll": true,
      "ready": "div.issue-item",
      "enabled": true
    },
    {
      "key": "tectonics",
      "name": "Tectonics",
      "parser": "agu",
      "url": "https://agupubs.onlinelibrary.wiley.com/journal/19449194",
      "wait": 5,
      "scroll": true,
      "ready": "div.issue-item",
      "enabled": true
    },
    {
      "key": "gcubed",
      "name": "G-Cubed",
      "parser": "agu",
      "url": "https://agupubs.onlinelibrary.wiley.com/journal/15252027",
      "wait": 5,
      "scroll": true,
      "ready": "div.issue-item",
      "enabled": true
    },
    {
      "key": "geology_current",
      "name": "Geology (Current)",
      "parser": "geology_current",
      "url": "https://pubs.geoscienceworld.org/geology/issue/current",
      "wait": 6,
      "scroll": true,
      "ready": "h3.item-title",
      "enabled": true
    },
    {
      "key": "geology_early",
      "name": "Geology (Early Publication)",
      "parser": "geology_early",
      "url": "https://pubs.geoscienceworld.org/geology/early-publication",
      "wait": 6,
      "scroll": true,
      "ready": "h5.al-title",
      "enabled": true
    },
    {
      "key": "gji",
      "name": "GJI",
      "parser": "gji",
      "url": "https://academic.oup.com/gji",
      "wait": 8,
      "scroll": false,
      "ready": "div.widget-dynamic-entry",
      "enabled": true
    },
    {
      "key": "science_current",
      "name": "Science (Current)",
      "parser": "science_current",
      "url": "https://www.science.org/toc/science/current",
      "wait": 6,
      "scroll": true,
      "ready": "h3[class*=\"article-title\"]",
      "enabled": true
    },
    {
      "key": "pnas",
      "name": "PNAS",
      "parser": "pnas",
      "url": "https://www.pnas.org/topic/earth-sci",
      "wait": 8,
      "scroll": true,
      "ready": "div.card",
      "enabled": true
    }
  ]
}
