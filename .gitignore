# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and builds
build/
dist/
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local extraction artifacts (evidence packs are reproducible; notes and figures are kept)
.raw/
.geo-reader/
output/
test_output/

# Local reading data: this repository ships the code, not the user's library.
# A test/reading workspace keeps these files locally; they are never published.
papers/*.md
papers/assets/*
!papers/assets/.gitkeep
input_pdfs/*.pdf
reading_list_*.md

# OS specific files
.DS_Store
Thumbs.db

# IDE specific files (workspace settings are intentionally tracked)
.idea/
